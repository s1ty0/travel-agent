# Copy to .env locally. Never commit the real key.
DEEPSEEK_API_KEY=
# Set this to a model available to your official DeepSeek account.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_OUTPUT_TOKENS=512
# Optional server-side Amap Web-service key, not a browser JS key.
AMAP_WEB_API_KEY=
# Only enable after confirming the account uses free quota with no paid fallback.
AMAP_FREE_QUOTA_ONLY=0
# Integer CNY cents; the user raised the per-run limit to 5 CNY on 2026-11-11.
SERVICE_BUDGET_MINOR=500

# Remote live mode. Keep disabled for the local development workflow.
# Enable only after the proxy and provider account are ready.
TRAVEL_TRIAL_ENABLED=0
# Total admin-funded plans across all sessions for this database. 0 disables trials.
TRAVEL_TRIAL_GLOBAL_CAP=0
# Fernet key shared only by API and worker, separate from the bridge and provider keys.
TRAVEL_TASK_KEY_ENCRYPTION=
